<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Refund Processed</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f9fafb;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f9fafb; padding: 40px 10px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 600px;
              background: #ffffff;
              border-radius: 24px;
              overflow: hidden;
              box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
              border: 1px solid #e5e7eb;
            "
          >
            <tr>
              <td
                align="center"
                style="
                  padding: 60px 40px 30px 40px;
                  background: linear-gradient(
                    to bottom,
                    #f0f9ff 0%,
                    #ffffff 100%
                  );
                "
              >
                <div style="margin-bottom: 20px">
                  <img
                    src="https://d1dmb2897axey0.cloudfront.net/default/logo.png"
                    alt="Arts & Craft Studio"
                    width="120"
                    style="display: block; margin: 0 auto; border-radius: 15px"
                  />
                </div>
                <h1
                  style="
                    color: #1f2937;
                    margin: 0;
                    font-size: 28px;
                    font-weight: 800;
                    letter-spacing: -0.5px;
                    text-align: center;
                  "
                >
                  Arts & Craft Studio
                </h1>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 50px; text-align: center">
                <div
                  style="
                    display: inline-block;
                    padding: 6px 16px;
                    background-color: #e0f2fe;
                    color: #0369a1;
                    border-radius: 30px;
                    font-size: 13px;
                    font-weight: 700;
                    text-transform: uppercase;
                    margin-bottom: 25px;
                  "
                >
                  💸 Refund Successful
                </div>

                <h2
                  style="
                    color: #111827;
                    font-size: 32px;
                    margin: 0 0 20px 0;
                    line-height: 1.1;
                    font-weight: 800;
                  "
                >
                  Your refund is on its way
                </h2>

                <p
                  style="
                    color: #4b5563;
                    font-size: 17px;
                    line-height: 1.6;
                    margin: 0;
                  "
                >
                  Hi <strong><%= name %></strong>, <br />
                  This email confirms that we've processed a refund for your
                  order (<strong>#<%= orderId %></strong>). You should see the
                  funds back in your account soon.
                </p>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 40px 50px">
                <table
                  width="100%"
                  style="
                    background-color: #f8fafc;
                    border-radius: 16px;
                    border: 1px solid #e2e8f0;
                    border-collapse: separate;
                  "
                >
                  <tr>
                    <td style="padding: 25px; text-align: center">
                      <span
                        style="
                          color: #64748b;
                          font-size: 14px;
                          text-transform: uppercase;
                          font-weight: bold;
                          display: block;
                          margin-bottom: 5px;
                        "
                        >Refund Amount</span
                      >
                      <span
                        style="
                          color: #0369a1;
                          font-size: 36px;
                          font-weight: 800;
                        "
                        >$<%= refundAmount %></span
                      >
                      <p
                        style="
                          margin: 15px 0 0 0;
                          color: #64748b;
                          font-size: 14px;
                        "
                      >
                        Refunded to your <strong><%= paymentMethod %></strong>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 50px 40px 50px">
                <h4
                  style="
                    margin: 0 0 10px 0;
                    color: #1e293b;
                    font-size: 16px;
                    text-align: center;
                  "
                >
                  What happens next?
                </h4>
                <p
                  style="
                    margin: 0;
                    color: #6b7280;
                    font-size: 14px;
                    text-align: center;
                    line-height: 1.5;
                  "
                >
                  Financial institutions typically take
                  <strong>10-15 business days</strong> to reflect the credit on
                  your statement. If you don't see it after 15 days, please
                  contact your bank.
                </p>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 0 50px 45px 50px">
                <table cellpadding="0" cellspacing="0">
                  <tr>
                    <td
                      align="center"
                      style="background-color: #6366f1; border-radius: 14px"
                    >
                      <a
                        href="https://artsandcraftstudio.in"
                        style="
                          display: inline-block;
                          padding: 18px 45px;
                          font-size: 16px;
                          color: #ffffff;
                          text-decoration: none;
                          font-weight: bold;
                          letter-spacing: 0.5px;
                        "
                      >
                        Return to Shop
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 50px">
                <div
                  style="height: 1px; background-color: #f3f4f6; width: 100%"
                ></div>
              </td>
            </tr>

            <tr>
              <td style="padding: 40px 50px; text-align: center">
                <p
                  style="
                    font-size: 12px;
                    color: #9ca3af;
                    margin: 0;
                    line-height: 1.5;
                  "
                >
                  &copy; <%= new Date().getFullYear() %> Arts & Craft Studio
                  Inc.<br />
                </p>
              </td>
            </tr>
          </table>

          <table width="100%" style="max-width: 600px; margin-top: 25px">
            <tr>
              <td
                align="center"
                style="font-size: 12px; color: #9ca3af; padding-bottom: 20px"
              >
                Have questions about your refund?
                <a
                  href="mailto:support.artsandcraftstudio@gmail.com"
                  style="color: #6366f1; text-decoration: none"
                  >Contact our billing team</a
                >
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
