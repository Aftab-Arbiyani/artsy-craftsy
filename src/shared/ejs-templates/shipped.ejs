<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Out for Delivery</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f9fafb;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f9fafb; padding: 40px 10px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 600px;
              background: #ffffff;
              border-radius: 24px;
              overflow: hidden;
              box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
              border: 1px solid #e5e7eb;
            "
          >
            <tr>
              <td
                align="center"
                style="
                  padding: 60px 40px 30px 40px;
                  background: linear-gradient(
                    to bottom,
                    #f5f3ff 0%,
                    #ffffff 100%
                  );
                "
              >
                <div style="margin-bottom: 20px">
                  <img
                    src="https://d1dmb2897axey0.cloudfront.net/default/logo.png"
                    alt="ArtsyCraftsy"
                    width="120"
                    style="display: block; margin: 0 auto; border-radius: 15px"
                  />
                </div>
                <h1
                  style="
                    color: #1f2937;
                    margin: 0;
                    font-size: 28px;
                    font-weight: 800;
                    letter-spacing: -0.5px;
                    text-align: center;
                  "
                >
                  ArtsyCraftsy
                </h1>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 50px; text-align: center">
                <div
                  style="
                    display: inline-block;
                    padding: 6px 16px;
                    background-color: #e0e7ff;
                    color: #4338ca;
                    border-radius: 30px;
                    font-size: 13px;
                    font-weight: 700;
                    text-transform: uppercase;
                    margin-bottom: 25px;
                  "
                >
                  🚚 Order #<%= orderId %> • Out for Delivery
                </div>

                <h2
                  style="
                    color: #111827;
                    font-size: 32px;
                    margin: 0 0 20px 0;
                    line-height: 1.1;
                    font-weight: 800;
                  "
                >
                  It's arriving today!
                </h2>

                <p
                  style="
                    color: #4b5563;
                    font-size: 17px;
                    line-height: 1.6;
                    margin: 0;
                  "
                >
                  Great news, <strong><%= name %></strong>! <br />
                  The artist has finished your piece, and it's officially on the
                  final leg of its journey. Your package should be arriving at
                  your door shortly.
                </p>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 40px 50px">
                <div
                  style="
                    background-color: #f8fafc;
                    border-radius: 16px;
                    padding: 25px;
                    border: 1px solid #e2e8f0;
                    text-align: center;
                  "
                >
                  <p
                    style="
                      margin: 0 0 5px 0;
                      color: #64748b;
                      font-size: 13px;
                      text-transform: uppercase;
                      font-weight: bold;
                      letter-spacing: 1px;
                    "
                  >
                    Tracking Number
                  </p>
                  <p
                    style="
                      margin: 0;
                      color: #1f2937;
                      font-size: 20px;
                      font-weight: 700;
                      font-family: monospace;
                    "
                  >
                    <%= trackingNumber %>
                  </p>
                  <p
                    style="margin: 15px 0 0 0; color: #94a3b8; font-size: 13px"
                  >
                    via <%= carrierName %>
                  </p>
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 50px 40px 50px; text-align: left">
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="border-top: 1px solid #f3f4f6; padding-top: 30px"
                >
                  <tr>
                    <td width="50%" valign="top">
                      <h4
                        style="
                          margin: 0 0 8px 0;
                          color: #1e293b;
                          font-size: 14px;
                          text-transform: uppercase;
                          letter-spacing: 1px;
                        "
                      >
                        Delivering To:
                      </h4>
                      <p
                        style="
                          margin: 0;
                          color: #4b5563;
                          font-size: 14px;
                          line-height: 1.5;
                        "
                      >
                        <%= address.street %><br />
                        <%= address.city %>, <%= address.state %> <%=
                        address.zip %>
                      </p>
                    </td>
                    <td width="50%" valign="top" style="text-align: right">
                      <h4
                        style="
                          margin: 0 0 8px 0;
                          color: #1e293b;
                          font-size: 14px;
                          text-transform: uppercase;
                          letter-spacing: 1px;
                        "
                      >
                        Order Info:
                      </h4>
                      <p
                        style="
                          margin: 0;
                          color: #4b5563;
                          font-size: 14px;
                          line-height: 1.5;
                        "
                      >
                        Order ID: <strong>#<%= orderId %></strong><br />
                        Carrier: <%= carrierName %>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding: 40px 50px;
                  text-align: center;
                  border-top: 1px solid #f3f4f6;
                  background-color: #fafafa;
                "
              >
                <p style="font-size: 14px; color: #4b5563; margin-bottom: 10px">
                  <strong>Can't wait to see it?</strong><br />
                  Once it arrives, share a photo and tag us
                  <strong>#ArtsyCraftsyMade</strong>
                </p>
                <p
                  style="
                    font-size: 12px;
                    color: #9ca3af;
                    margin: 30px 0 0 0;
                    line-height: 1.5;
                  "
                >
                  &copy; <%= new Date().getFullYear() %> ArtsyCraftsy Inc.<br />
                </p>
              </td>
            </tr>
          </table>

          <table width="100%" style="max-width: 600px; margin-top: 25px">
            <tr>
              <td
                align="center"
                style="font-size: 12px; color: #9ca3af; padding-bottom: 20px"
              >
                Questions about Order #<%= orderId %>?
                <a
                  href="mailto:support.artsandcraftstudio@gmail.com"
                  style="color: #6366f1; text-decoration: none"
                  >Contact Support</a
                >
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
